# Endereço da API (gateway ou MS1). Em desenvolvimento, o MS1 roda na porta 7502.
NEXT_PUBLIC_API_URL=http://localhost:7502

# true = usa os dados de mentira (src/data/mock.ts). false = chama a API de verdade.
NEXT_PUBLIC_USAR_MOCK=true

# Só para testar com a API de verdade, antes de existir login. Nunca coloque um token real neste arquivo de exemplo.
# NEXT_PUBLIC_TOKEN_DE_TESTE=